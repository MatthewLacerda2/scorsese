{
  // The house rules alone, over their own fixtures: src/lint/houseRules.test.ts
  // runs Biome with this config. The web's own biome.jsonc leaves this folder out,
  // since a fixture that must be flagged would fail the real lint.
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "plugins": ["../oneComponentPerFile.grit", "../noRawStorage.grit"],
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": { "rules": { "preset": "none" } }
}
