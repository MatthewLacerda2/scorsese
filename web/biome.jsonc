{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    // lint/fixtures holds files the house rules must flag; src/lint/houseRules.test.ts
    // lints them with lint/fixtures/rules.jsonc instead.
    "includes": ["**", "!dist", "!landing", "!test-results", "!playwright-report", "!lint/fixtures"]
  },
  // The web's house rules (web/README.md, *House rules*): GritQL plugins in lint/,
  // each with fixtures, run by `biome ci` like any built-in rule.
  "plugins": [
    {
      "path": "./lint/oneComponentPerFile.grit",
      // components/ui is shadcn's, which ships compound modules (Card, CardHeader…)
      // on purpose, and is re-added with `shadcn add` rather than hand-shaped.
      "includes": ["**/*.tsx", "!**/src/components/ui/**"]
    },
    {
      "path": "./lint/noRawStorage.grit",
      // lib/storage.ts is the one module that touches storage; test/ is the test
      // setup, which clears it between tests.
      "includes": ["**/src/**", "!**/src/lib/storage.ts", "!**/src/test/**"]
    },
    {
      "path": "./lint/literalUiText.grit",
      // A test's JSX is a harness nobody but the test reads; src/test/ is the tests' own.
      "includes": ["**/*.tsx", "!**/*.test.tsx", "!**/src/test/**"]
    },
    {
      "path": "./lint/colorsFromTokens.grit",
      // components/ui is shadcn's, re-added with `shadcn add` rather than
      // hand-shaped, and its variants speak the same tokens already. The
      // tests are fixtures of their own: a colour in one is an input.
      "includes": [
        "**/*.ts",
        "**/*.tsx",
        "!**/src/components/ui/**",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ]
    },
    {
      "path": "./lint/serverUrlOutsideApi.grit",
      // src/api is where server paths live; tests name the URL they expect or fake.
      "includes": [
        "**/src/**",
        "!**/src/api/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/src/test/**"
      ]
    },
    {
      "path": "./lint/shadcnControls.grit",
      // components/ui is where the shadcn controls are built from the native
      // elements. Tests render controls of their own as a harness.
      "includes": ["**/*.tsx", "!**/src/components/ui/**", "!**/*.test.tsx", "!**/src/test/**"]
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noShadow": "error" },
      // A label wrapping shadcn's Input is wrapping an input.
      "a11y": {
        "noLabelWithoutControl": { "level": "error", "options": { "inputComponents": ["Input"] } }
      },
      "style": {
        // Only src/api talks to the server (web/README.md, *How it is laid out*);
        // the overrides below name the files that may.
        "noRestrictedGlobals": {
          "level": "error",
          "options": {
            "deniedGlobals": {
              "fetch": "Call the server through `api` (src/api), never `fetch` in a page.",
              "EventSource": "Listen with `useServerEvents` (src/app/events.ts): one stream per page."
            }
          }
        },
        // A page is a lazy chunk (#896): imported only by src/app/pages.ts.
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@/pages/**", "../pages/**", "../../pages/**"],
                "message": "A page is imported only by src/app/pages.ts, lazily, so the landing page never downloads it."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      // src/api is the door to the server, src/app/events.ts holds the one stream,
      // and tests stand in their own transport.
      "includes": [
        "**/src/api/**",
        "**/src/app/events.ts",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/src/test/**",
        "**/tests/**"
      ],
      "linter": { "rules": { "style": { "noRestrictedGlobals": "off" } } }
    },
    {
      "includes": ["**/src/app/pages.ts"],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
