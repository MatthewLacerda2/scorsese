#!/usr/bin/env bash
# Terraform on one of deploy/terraform's four configurations, with the
# credentials each needs:
#
#   deploy/terraform/tf cloudflare plan
#   deploy/terraform/tf google apply
#   deploy/terraform/tf stripe secret
#   deploy/terraform/tf github plan
#
# `make infra-plan` and `make infra-apply` call it for all four. It reads what it
# needs from the env file (DEPLOY_ENV, default deploy/.env beside this folder)
# without sourcing it.
#
# Every state lives in one versioned Google Cloud Storage bucket, which the
# google configuration makes (google/state.tf), under a prefix of its own:
# cloudflare, github, google, stripe-test, stripe-live. So every configuration
# needs the maintainer's `gcloud` login, whatever vendor it manages, and a
# worktree or even a machine can be thrown away without losing one.
#
#   cloudflare  CLOUDFLARE_API_TOKEN, CLOUDFLARE_TUNNEL_TOKEN (which names the
#               account and the tunnel) and SCORSESE_SECURITY_FORWARD_TO.
#   google      the `gcloud` login alone: a short-lived access token, so no key
#               file exists anywhere.
#   stripe      STRIPE_SECRET_KEY and SCORSESE_PUBLIC_ORIGIN. Test and live
#               mode are separate at Stripe, with separate endpoints, so the
#               state is stripe-test or stripe-live by the key's mode.
#               `tf stripe secret` writes the endpoint's signing secret into
#               the env file as STRIPE_WEBHOOK_SECRET, printing nothing.
#   github      the maintainer's own `gh` login, through `gh auth token`, so
#               no key exists anywhere either.
#
# The states began as files in $SCORSESE_DATA/terraform/<state>.tfstate, and
# moved into the bucket once, in this order (docs/web.md, "Moving the state
# into the bucket"):
#
#   tf google bootstrap apply   # the google state still on disk; makes the bucket
#   tf google migrate           # then each configuration's file moves in
#   tf cloudflare migrate
#   tf github migrate
#   tf stripe migrate           # both stripe-test and stripe-live, no key needed
#
# `migrate` keeps the file it moved as <state>.tfstate.migrated, and every
# other command refuses while a <state>.tfstate is still on disk, so nothing
# is ever applied against an empty state by mistake.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
bucket=scorseseestudio-tfstate # google/state.tf's state_bucket
root=${1:-}
case "$root" in
  cloudflare | google | stripe | github) shift ;;
  *) echo "usage: tf cloudflare|google|stripe|github <terraform command…|migrate|bootstrap …>" >&2; exit 2 ;;
esac

env_file=${DEPLOY_ENV:-$here/../.env}
[ -f "$env_file" ] || { echo "tf: no env file at $env_file (set DEPLOY_ENV)" >&2; exit 1; }

value() {
  sed -n "s/^$1=//p" "$env_file" | tail -n 1 | sed -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'$/\1/"
}
need() {
  local v
  v=$(value "$1")
  [ -n "$v" ] || { echo "tf: $1 is blank in $env_file -- deploy/.env.example says what it is" >&2; exit 1; }
  printf '%s' "$v"
}

command -v gcloud >/dev/null 2>&1 || {
  echo "tf: gcloud is not installed, and every Terraform state is in Google Cloud Storage" >&2; exit 1; }
GOOGLE_OAUTH_ACCESS_TOKEN=$(gcloud auth print-access-token 2>/dev/null) || {
  echo "tf: gcloud is not logged in, and every Terraform state is in Google Cloud Storage -- run 'gcloud auth login'" >&2
  exit 1; }
export GOOGLE_OAUTH_ACCESS_TOKEN

# Where the states were before the bucket: SCORSESE_DATA, if it is set. A
# machine that never held them has nothing to migrate or to guard against.
data=$(value SCORSESE_DATA)
old_states=${data:+$data/terraform}
old_state() {
  [ -n "$old_states" ] || { echo "tf: SCORSESE_DATA is blank in $env_file, so there is no old state" >&2; exit 1; }
  printf '%s' "$old_states/$1.tfstate"
}

tf() { terraform -chdir="$here/$root" "$@"; }

# Point the configuration at the bucket, under one state's prefix.
init_bucket() {
  tf init -input=false -reconfigure \
    -backend-config="bucket=$bucket" -backend-config="prefix=$1" >/dev/null
}

# Point it at an old state file instead, through an override file that lives
# no longer than this script: the one way to reach a `local` state once the
# configuration says `gcs`. Terraform records the choice in .terraform/, which
# is what lets `init -migrate-state` find the state it moves.
override="$here/$root/tf_local_override.tf"
trap 'rm -f "$override"' EXIT
init_local() {
  printf 'terraform {\n  backend "local" {}\n}\n' >"$override"
  tf init -input=false -reconfigure -backend-config="path=$1" >/dev/null
}

lineage() { sed -n 's/^ *"lineage": *"\([^"]*\)".*/\1/p' | head -n 1; }

if [ "${1:-}" = migrate ]; then
  gcloud storage buckets describe "gs://$bucket" >/dev/null 2>&1 || {
    echo "tf: gs://$bucket does not exist yet -- 'tf google bootstrap apply' makes it" >&2; exit 1; }
  case "$root" in
    stripe) states="stripe-test stripe-live" ;;
    *) states=$root ;;
  esac
  for state in $states; do
    file=$(old_state "$state")
    [ -f "$file" ] || { echo "tf: no $file, so nothing of $state's to migrate" >&2; continue; }
    cp -p "$file" "$file.migrated"
    init_local "$file"
    rm -f "$override"
    # Terraform asks before it copies; answer yes.
    tf init -migrate-state -backend-config="bucket=$bucket" -backend-config="prefix=$state"
    [ "$(tf state pull | lineage)" = "$(lineage <"$file.migrated")" ] || {
      echo "tf: gs://$bucket/$state does not hold the state $file did; $file is left where it was" >&2
      exit 1; }
    rm -f "$file"
    echo "tf: $state is in gs://$bucket/$state; the old file is $file.migrated --" \
      "delete it once 'make infra-plan' shows no changes" >&2
  done
  exit 0
fi

case "$root" in
  cloudflare)
    CLOUDFLARE_API_TOKEN=$(need CLOUDFLARE_API_TOKEN)
    TF_VAR_tunnel_token=$(need CLOUDFLARE_TUNNEL_TOKEN)
    TF_VAR_security_forward_to=$(need SCORSESE_SECURITY_FORWARD_TO)
    export CLOUDFLARE_API_TOKEN TF_VAR_tunnel_token TF_VAR_security_forward_to
    ;;
  github)
    command -v gh >/dev/null 2>&1 || { echo "tf: gh is not installed" >&2; exit 1; }
    GITHUB_TOKEN=$(gh auth token 2>/dev/null) || {
      echo "tf: gh is not logged in -- run 'gh auth login'" >&2; exit 1; }
    export GITHUB_TOKEN
    ;;
  stripe)
    STRIPE_API_KEY=$(need STRIPE_SECRET_KEY)
    TF_VAR_public_origin=$(need SCORSESE_PUBLIC_ORIGIN)
    export STRIPE_API_KEY TF_VAR_public_origin
    case "$STRIPE_API_KEY" in
      sk_test_* | rk_test_*) state=stripe-test ;;
      sk_live_* | rk_live_*) state=stripe-live ;;
      *) echo "tf: STRIPE_SECRET_KEY is neither a test nor a live key" >&2; exit 1 ;;
    esac
    ;;
esac
state=${state:-$root}

# The google configuration makes the bucket, so its first apply runs against
# its old file. Once its state is in the bucket, that file is stale.
if [ "${1:-}" = bootstrap ]; then
  shift
  [ "$root" = google ] || { echo "tf: only google is bootstrapped; the others 'migrate'" >&2; exit 2; }
  if gcloud storage objects describe "gs://$bucket/google/default.tfstate" >/dev/null 2>&1; then
    echo "tf: google's state is in gs://$bucket already; run 'tf google $*' without bootstrap" >&2
    exit 1
  fi
  file=$(old_state google)
  [ -f "$file" ] || { echo "tf: no $file to bootstrap from" >&2; exit 1; }
  init_local "$file"
  tf "$@" # the override stays until this script exits
  exit
fi

if [ -n "$old_states" ] && [ -f "$old_states/$state.tfstate" ]; then
  echo "tf: $state's state is still in $old_states/$state.tfstate, not the bucket --" \
    "move it first (docs/web.md, \"Moving the state into the bucket\")" >&2
  exit 1
fi
init_bucket "$state"

if [ "$root" = stripe ] && [ "${1:-}" = secret ]; then
  # The secret reaches the file through the environment, never an argument
  # (which `ps` shows) or the terminal; `cat >` keeps the file's permissions.
  secret=$(tf output -raw webhook_secret 2>/dev/null) || secret=
  case "$secret" in
    whsec_*) ;;
    *) echo "tf: no signing secret in the $state state -- Stripe returns it only when" \
         "the endpoint is created, so apply first (docs/web.md, \"Infrastructure, as code\")" >&2
       exit 1 ;;
  esac
  updated=$(SECRET=$secret awk '
    /^STRIPE_WEBHOOK_SECRET=/ { if (!done) print "STRIPE_WEBHOOK_SECRET=" ENVIRON["SECRET"]; done = 1; next }
    { print }
    END { if (!done) print "STRIPE_WEBHOOK_SECRET=" ENVIRON["SECRET"] }' "$env_file")
  printf '%s\n' "$updated" >"$env_file"
  echo "tf: STRIPE_WEBHOOK_SECRET written to $env_file ($state endpoint); restart the server to use it" >&2
  exit 0
fi

exec terraform -chdir="$here/$root" "$@"
