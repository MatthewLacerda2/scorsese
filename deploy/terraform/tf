#!/usr/bin/env bash
# Terraform on one of deploy/terraform's three configurations, with the
# credentials each needs:
#
#   deploy/terraform/tf cloudflare plan
#   deploy/terraform/tf google apply
#   deploy/terraform/tf stripe secret
#
# `make infra-plan` and `make infra-apply` call it for all three. It reads what it
# needs from the env file (DEPLOY_ENV, default deploy/.env beside this folder)
# without sourcing it, and keeps each state at
# $SCORSESE_DATA/terraform/<name>.tfstate, outside the checkout, so applying
# from a worktree that is then removed loses nothing.
#
#   cloudflare  CLOUDFLARE_API_TOKEN, CLOUDFLARE_TUNNEL_TOKEN (which names the
#               account and the tunnel) and SCORSESE_SECURITY_FORWARD_TO.
#   google      the maintainer's own `gcloud` login: a short-lived access
#               token, so no key file exists anywhere.
#   stripe      STRIPE_SECRET_KEY and SCORSESE_PUBLIC_ORIGIN. Test and live
#               mode are separate at Stripe, with separate endpoints, so the
#               state is stripe-test or stripe-live by the key's mode.
#               `tf stripe secret` writes the endpoint's signing secret into
#               the env file as STRIPE_WEBHOOK_SECRET, printing nothing.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
root=${1:-}
case "$root" in
  cloudflare | google | stripe) shift ;;
  *) echo "usage: tf cloudflare|google|stripe <terraform command…>" >&2; exit 2 ;;
esac

env_file=${DEPLOY_ENV:-$here/../.env}
[ -f "$env_file" ] || { echo "tf: no env file at $env_file (set DEPLOY_ENV)" >&2; exit 1; }

value() {
  sed -n "s/^$1=//p" "$env_file" | tail -n 1 | sed -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'$/\1/"
}
need() {
  local v
  v=$(value "$1")
  [ -n "$v" ] || { echo "tf: $1 is blank in $env_file -- deploy/.env.example says what it is" >&2; exit 1; }
  printf '%s' "$v"
}

case "$root" in
  cloudflare)
    CLOUDFLARE_API_TOKEN=$(need CLOUDFLARE_API_TOKEN)
    TF_VAR_tunnel_token=$(need CLOUDFLARE_TUNNEL_TOKEN)
    TF_VAR_security_forward_to=$(need SCORSESE_SECURITY_FORWARD_TO)
    export CLOUDFLARE_API_TOKEN TF_VAR_tunnel_token TF_VAR_security_forward_to
    ;;
  google)
    command -v gcloud >/dev/null 2>&1 || { echo "tf: gcloud is not installed" >&2; exit 1; }
    GOOGLE_OAUTH_ACCESS_TOKEN=$(gcloud auth print-access-token) || {
      echo "tf: gcloud is not logged in -- run 'gcloud auth login'" >&2; exit 1; }
    export GOOGLE_OAUTH_ACCESS_TOKEN
    ;;
  stripe)
    STRIPE_API_KEY=$(need STRIPE_SECRET_KEY)
    TF_VAR_public_origin=$(need SCORSESE_PUBLIC_ORIGIN)
    export STRIPE_API_KEY TF_VAR_public_origin
    case "$STRIPE_API_KEY" in
      sk_test_* | rk_test_*) state=stripe-test ;;
      sk_live_* | rk_live_*) state=stripe-live ;;
      *) echo "tf: STRIPE_SECRET_KEY is neither a test nor a live key" >&2; exit 1 ;;
    esac
    ;;
esac

state_dir="$(need SCORSESE_DATA)/terraform"
mkdir -p "$state_dir"
terraform -chdir="$here/$root" init -input=false -reconfigure \
  -backend-config="path=$state_dir/${state:-$root}.tfstate" >/dev/null

if [ "$root" = stripe ] && [ "${1:-}" = secret ]; then
  # The secret reaches the file through the environment, never an argument
  # (which `ps` shows) or the terminal; `cat >` keeps the file's permissions.
  secret=$(terraform -chdir="$here/$root" output -raw webhook_secret 2>/dev/null) || secret=
  case "$secret" in
    whsec_*) ;;
    *) echo "tf: no signing secret in the $state state -- Stripe returns it only when" \
         "the endpoint is created, so apply first (docs/web.md, \"Infrastructure, as code\")" >&2
       exit 1 ;;
  esac
  updated=$(SECRET=$secret awk '
    /^STRIPE_WEBHOOK_SECRET=/ { if (!done) print "STRIPE_WEBHOOK_SECRET=" ENVIRON["SECRET"]; done = 1; next }
    { print }
    END { if (!done) print "STRIPE_WEBHOOK_SECRET=" ENVIRON["SECRET"] }' "$env_file")
  printf '%s\n' "$updated" >"$env_file"
  echo "tf: STRIPE_WEBHOOK_SECRET written to $env_file ($state endpoint); restart the server to use it" >&2
  exit 0
fi

exec terraform -chdir="$here/$root" "$@"
