# The hosted service's configuration. Copy to deploy/.env (gitignored) and fill
# in every line: compose.yaml refuses to start with any of them blank — except
# the two that belong to a tunnel mode, COMPOSE_PROFILES and
# CLOUDFLARE_TUNNEL_TOKEN, where blank means something (below).
#
# This is not the repo root's .env.example. That one is for developing — the
# CLI, the MCP server, a server run by hand. This one is only what the deployed
# containers are told. docs/web.md, "Running the service", walks through it.

# The database password. Letters and digits only: it is spliced into the
# server's DATABASE_URL, where other characters would need escaping.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# The host directory the service keeps its files in, absolute. It must exist
# and belong to the user below; compose will not create it. Inside it:
#   library/   users' files — backed up
#   backups/   the newest database dumps, and when the last backup worked
#   cache/     thumbnails, uploads arriving, finished renders — rebuildable,
#              never backed up (the server makes it)
SCORSESE_DATA=

# How much disk finished renders and page captures aim to stay under: 500MB,
# 20GB, 1TB. When a new render would pass it, every render and capture nobody
# used in 48 hours is deleted; if none is that old the new one is kept anyway,
# so it is a target, not a wall.
SCORSESE_RENDER_QUOTA=20GB

# The host user the server and the backup run as, so every file under
# SCORSESE_DATA is that user's. `id -u` and `id -g`.
SCORSESE_UID=
SCORSESE_GID=

# The group that owns the Docker socket, /var/run/docker.sock — the docker
# group's number, `getent group docker | cut -d: -f3`. The capture launcher
# joins it to start each page capture in a container of its own (#852), and is
# the only container that does.
SCORSESE_DOCKER_GID=

# The provider keys users' paid generations are made with (docs/web.md, "Web
# MCP"): Gemini for Veo shots, ElevenLabs for narration. Blank is allowed — a
# generation that needs a missing key fails, and is not charged. Secrets, like
# the password above.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# The assistant (docs/web.md, "The assistant"): a model editing for users, paid
# from their credits at cost + 10%. Each project picks its model (#705); the
# Gemini models spend GEMINI_API_KEY above, the Claude ones this key. Blank is
# allowed — the rest of the site works and a model whose key is missing says
# so, word for word. A secret, like the others.
ANTHROPIC_API_KEY=
# The most one message to the assistant may cost a user, in dollars; the turn
# stops between steps once it has. Blank is 2.00.
SCORSESE_ASSISTANT_TURN_CAP=

# Where the site answers without a tunnel: http://<bind>:<port>.
#
# 127.0.0.1 is this machine only, and is also all `tailscale serve` needs to
# put the site on a tailnet over HTTPS — the way to reach it from other devices,
# friends' included (docs/web.md, "Testing before there is a domain").
#
# 0.0.0.0 (or one interface's address) opens it to that network over plain
# HTTP, and a browser there CANNOT STAY LOGGED IN: the session cookie is
# `Secure`, and browsers only keep a Secure cookie from https:// or localhost.
# Deliberately so; the runbook says why. The site and API tokens still work,
# which is all plain HTTP from another device is for.
SCORSESE_WEB_BIND=127.0.0.1
SCORSESE_WEB_PORT=8088

# Which tunnel, if any, puts the site on the internet — one of:
#   named-tunnel   production: a domain on Cloudflare and the token below
#   quick-tunnel   testing: a random https://<words>.trycloudflare.com, no
#                  account needed, a new address every time it restarts
#   (blank)        no tunnel: loopback and a tailnet only
# Blank by default, because the safe mistake is a site nobody can reach. Compose
# reads this name itself and starts only that tunnel's container.
COMPOSE_PROFILES=

# The named tunnel's token, from the Cloudflare dashboard (Zero Trust ->
# Networks -> Tunnels -> your tunnel -> the `cloudflared` install command, the
# long string after --token). It is the tunnel's whole identity: keep it as
# secret as the password above. Only `named-tunnel` reads it; blank otherwise.
CLOUDFLARE_TUNNEL_TOKEN=

# Where backups go: an rclone remote and a path on it, e.g. `offsite:scorsese`.
# It must be off this machine — a second disk in the same box burns in the same
# fire. Configure the remote once with `rclone config`.
SCORSESE_BACKUP_REMOTE=
# The directory holding the rclone.conf that defines that remote, absolute —
# usually /home/<you>/.config/rclone. Mounted read-write, because rclone
# refreshes OAuth tokens in it.
SCORSESE_RCLONE_CONFIG=
# How often to back up, and how long the remote keeps old dumps and the
# library files a sync replaced or deleted.
SCORSESE_BACKUP_EVERY_HOURS=24
SCORSESE_BACKUP_KEEP_DAYS=30
