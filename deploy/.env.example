# The hosted service's configuration. Copy to deploy/.env (gitignored) and fill
# in every line: compose.yaml refuses to start with any of them blank.
#
# This is not the repo root's .env.example. That one is for developing — the
# CLI, the MCP server, a server run by hand. This one is only what the deployed
# containers are told. docs/web.md, "Running the service", walks through it.

# The database password. Letters and digits only: it is spliced into the
# server's DATABASE_URL, where other characters would need escaping.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# The host directory the service keeps its files in, absolute. It must exist
# and belong to the user below; compose will not create it. Inside it:
#   library/   users' files — backed up
#   backups/   the newest database dumps, and when the last backup worked
#   cache/     thumbnails, uploads arriving, finished renders — rebuildable,
#              never backed up (the server makes it)
SCORSESE_DATA=

# How much disk finished renders aim to stay under: 500MB, 20GB, 1TB. When a
# new render would pass it, every render nobody used in 48 hours is deleted; if
# none is that old the new one is kept anyway, so it is a target, not a wall.
SCORSESE_RENDER_QUOTA=20GB

# The host user the server and the backup run as, so every file under
# SCORSESE_DATA is that user's. `id -u` and `id -g`.
SCORSESE_UID=
SCORSESE_GID=

# The loopback port the site answers on from this machine, without the tunnel:
# http://127.0.0.1:<port>. Nothing else on the network can reach it.
SCORSESE_WEB_PORT=8088

# The Cloudflare Tunnel's token, from the Cloudflare dashboard (Zero Trust ->
# Networks -> Tunnels -> your tunnel -> the `cloudflared` install command, the
# long string after --token). It is the tunnel's whole identity: keep it as
# secret as the password above.
CLOUDFLARE_TUNNEL_TOKEN=

# Where backups go: an rclone remote and a path on it, e.g. `offsite:scorsese`.
# It must be off this machine — a second disk in the same box burns in the same
# fire. Configure the remote once with `rclone config`.
SCORSESE_BACKUP_REMOTE=
# The directory holding the rclone.conf that defines that remote, absolute —
# usually /home/<you>/.config/rclone. Mounted read-write, because rclone
# refreshes OAuth tokens in it.
SCORSESE_RCLONE_CONFIG=
# How often to back up, and how long the remote keeps old dumps and the
# library files a sync replaced or deleted.
SCORSESE_BACKUP_EVERY_HOURS=24
SCORSESE_BACKUP_KEEP_DAYS=30
