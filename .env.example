# Copy to .env (gitignored) and fill in. Secrets never go in project files.
#
# This is the *development* path. A shipped build has no checkout to keep a
# .env in and reads a settings file instead — but it is one resolver and one
# order either way: the environment first, the settings file second. Run
# `scorsese settings` to see where that file is and which keys resolved; it
# never prints a key. See docs/credentials.md.

# Veo (video generation) — Gemini API key
GEMINI_API_KEY=
# ElevenLabs (TTS audio generation)
ELEVENLABS_API_KEY=
