# Copy to .env (gitignored) and fill in. Secrets never go in project files.
#
# This is the *development* path. A shipped build has no checkout to keep a
# .env in and reads a settings file instead — but it is one resolver and one
# order either way: the environment first, the settings file second. Run
# `scorsese settings` to see where that file is and which keys resolved; it
# never prints a key. See docs/credentials.md.

# Veo (video generation) — Gemini API key
GEMINI_API_KEY=

# ElevenLabs (narration, and the voice list to choose from)
#
# A key here can be present, correct, and still refused: ElevenLabs keys carry
# per-scope permissions, granted when the key is made. scorsese needs
# text-to-speech to generate narration and voices_read to list the voices to
# choose from, and a key without the second answers 401 on every listing while
# generating perfectly well. That refusal is reported as what it is — the key
# is fine, the permission is missing, and the fix is in the ElevenLabs
# dashboard rather than in this file.
ELEVENLABS_API_KEY=

# Pixabay (free stock footage and photos: stock_search, stock_import). Free —
# the key comes with a free Pixabay account, shown on
# https://pixabay.com/api/docs/ while logged in. It never spends anything.
PIXABAY_API_KEY=

# Anthropic (Claude) — only the web server's assistant uses it (docs/web.md,
# "The assistant"); the CLI, the MCP server and the desktop app never do.
# Blank is fine: the server runs, and the assistant answers "not configured".
ANTHROPIC_API_KEY=

# scorsese-server, the web API. Only needed to run the server itself; the CLI,
# the MCP server and the desktop app never read these. `make test` does not
# use this DATABASE_URL: it hands the tests a throwaway Postgres of their own
# (see tools/with-postgres), which wins over anything written here.
DATABASE_URL=
# The absolute directory users' files are kept under.
SCORSESE_STORAGE=
# The absolute directory for what the server can rebuild -- thumbnails, uploads
# still arriving. Outside SCORSESE_STORAGE, which is what gets backed up.
SCORSESE_CACHE=
# How much disk finished renders aim to stay under. Defaults to 20GB.
SCORSESE_RENDER_QUOTA=
# Where the server listens. Defaults to 127.0.0.1:8080, this machine only.
SCORSESE_BIND=
# Sign in with Google (docs/web.md, "Accounts"). Blank is fine for
# development: sign-in is off, and `scorsese-server user session <email>`
# prints a cookie to sign in with instead. All three turn it on; the origin is
# where the browser reaches the site, e.g. http://localhost:5173 for the web
# app's dev server, and its /api/auth/google/callback must be a redirect URI
# of the client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SCORSESE_PUBLIC_ORIGIN=
# The most one assistant turn may cost a user on Claude Sonnet 5.5, in dollars;
# other models' caps scale from it by price. Defaults to 3.50.
SCORSESE_ASSISTANT_TURN_CAP=
# What the operator's ElevenLabs plan allows: calls in flight at once, every
# kind together, and designed voices the account holds. Default 3 and 10,
# Starter's.
SCORSESE_ELEVENLABS_CONCURRENCY=
SCORSESE_ELEVENLABS_VOICE_SLOTS=
