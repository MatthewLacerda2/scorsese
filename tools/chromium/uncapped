#!/usr/bin/env bash
# Run the pinned chrome-headless-shell with the address-space limit lifted.
#
#   ulimit -Sv 6291456
#   SCORSESE_CHROME="$PWD/tools/chromium/uncapped" cargo mutants ...
#
# The mutation shards cap every process at 6 GiB of address space, so a mutant
# that allocates without end aborts instead of taking the runner down. Chrome
# reserves tens of GiB of address space it never touches, so under that cap it
# cannot even print its version, and every test that captures a page fails the
# unmutated baseline (#1744). The cap is a soft limit there, which a process
# may raise; this raises it for the browser alone and runs the build
# tools/chromium/fetch prints, which is the pinned one and is already cached.

set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
ulimit -Sv unlimited
chrome=$("$here/fetch")
exec "$chrome" "$@"
